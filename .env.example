# Copia este archivo a ".env" y ajusta los valores antes de arrancar en producción.
# ".env" nunca debe subirse a git (ya está en .gitignore).

# Puerto del servidor
PORT=3000

# Entorno: "development" o "production"
NODE_ENV=development

# Secreto usado para firmar los JWT de sesión.
# OBLIGATORIO en producción. Genera uno fuerte, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clave requerida para poder registrar una cuenta de administrador (/api/auth/register-admin).
# Solo compártela con quien deba crear el usuario admin inicial.
ADMIN_SETUP_KEY=

# Orígenes permitidos para CORS, separados por coma.
# En producción, pon aquí el/los dominios reales donde se sirve la app.
ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# Claves de Stripe (modo prueba) para guardar métodos de pago.
# Dashboard → Developers → API keys. Sin estas claves, la pantalla de
# "Métodos de pago" funciona pero avisa que no está configurada.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Twilio Verify para el código SMS del login por teléfono.
# Console → Account Info (SID/Auth Token) → Verify → Services (Service SID).
# OBLIGATORIO en producción. Sin estas claves, en desarrollo se acepta
# el código de prueba fijo "123456" en vez de enviar un SMS real.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Payphone (Botón de Pago) - pasarela alternativa a Stripe.
# Panel de Payphone → Aplicaciones → Credenciales (Token y StoreId).
# Sin estas claves, la pasarela Payphone queda deshabilitada y el Super Admin
# no podrá activarla desde el switch de "Pasarela de pago" del panel.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# --- Producción ---
# URL pública de la app (se usa en los enlaces de los correos), sin barra final.
APP_BASE_URL=https://tu-dominio.com
# Detrás de un proxy con HTTPS (Caddy/Nginx/Cloudflare) pon 1; si no, el límite de intentos ve a todos como una sola IP.
TRUST_PROXY=1
# Zona horaria del negocio (horarios de comercios y "hoy" en finanzas).
STORE_TIMEZONE=America/Guayaquil

# Correo (recuperación de contraseña) con Resend: https://resend.com
# MAIL_FROM debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=Rapidín <no-responder@tu-dominio.com>

# Base de datos y copias de seguridad (en Docker ya vienen en /data).
# DB_PATH=/data/rapidin.db
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
# BACKUP_ENABLED=1   # fuerza las copias también fuera de producción

# En NODE_ENV=production el servidor NO arranca si JWT_SECRET tiene menos de 32 caracteres
# o contiene valores de ejemplo, ni si ADMIN_SETUP_KEY es débil.
