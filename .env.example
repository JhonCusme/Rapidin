# Copia este archivo a ".env" y ajusta los valores antes de arrancar en producción.
# ".env" nunca debe subirse a git (ya está en .gitignore).

# Puerto del servidor
PORT=3000

# Entorno: "development" o "production"
NODE_ENV=development

# Secreto usado para firmar los JWT de sesión.
# OBLIGATORIO en producción. Genera uno fuerte, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clave requerida para poder registrar una cuenta de administrador (/api/auth/register-admin).
# Solo compártela con quien deba crear el usuario admin inicial.
ADMIN_SETUP_KEY=

# Orígenes permitidos para CORS, separados por coma.
# En producción, pon aquí el/los dominios reales donde se sirve la app.
ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# Claves de Stripe (modo prueba) para guardar métodos de pago.
# Dashboard → Developers → API keys. Sin estas claves, la pantalla de
# "Métodos de pago" funciona pero avisa que no está configurada.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Twilio Verify para el código SMS del login por teléfono.
# Console → Account Info (SID/Auth Token) → Verify → Services (Service SID).
# OBLIGATORIO en producción. Sin estas claves, en desarrollo se acepta
# el código de prueba fijo "123456" en vez de enviar un SMS real.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
